#!/bin/sh

# 챕터 6: 배포 전 검증 자동화
# Pre-push hook: 푸시 전 철저한 검증

echo "🚀 푸시 전 최종 검증 시작..."

# 1. TypeScript 타입 체크
echo ""
echo "📝 [1/3] TypeScript 검사 중..."
npm run typecheck
if [ $? -ne 0 ]; then
  echo "❌ TypeScript 검사 실패"
  exit 1
fi
echo "✅ TypeScript 검사 통과"

# 2. ESLint 검사
echo ""
echo "📋 [2/3] ESLint 검사 중..."
npm run lint
if [ $? -ne 0 ]; then
  echo "❌ ESLint 검사 실패"
  exit 1
fi
echo "✅ ESLint 검사 통과"

# 3. 빌드 테스트
echo ""
echo "🏗️ [3/3] 빌드 테스트 중..."
npm run build:web
if [ $? -ne 0 ]; then
  echo "❌ 빌드 실패"
  exit 1
fi
echo "✅ 빌드 성공"

echo ""
echo "🎉 모든 검증 통과! 푸시를 진행합니다."
