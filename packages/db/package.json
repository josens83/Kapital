{
  "name": "@kapital/db",
  "version": "0.0.1",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "db:migrate": "supabase db push",
    "db:seed": "tsx src/seed.ts",
    "typecheck": "tsc --noEmit",
    "generate-types": "supabase gen types typescript --local > src/database.types.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0"
  },
  "devDependencies": {
    "@kapital/tsconfig": "*",
    "typescript": "^5.3.3",
    "tsx": "^4.7.0"
  }
}
